{
  "name": "pomade-planner",
  "version": "0.2.2",
  "description": "Two Pomade apps: Planner (to-dos, recurring tasks, daily notes) and Board (kanban over project backlogs)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:fake": "node scripts/dev.mjs --fake",
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "install-app": "npm run build && node scripts/install-app.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test:unit": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "pomade-kit": "github:dd-voronov/pomade-kit#v0.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}
